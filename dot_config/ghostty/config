##
## Ghostty configuration file
## https://ghostty.org/docs/config/reference
##

# 1 Appearance

theme = "tokyonight"
background-opacity = 0.8
background-blur-radius = 40
window-padding-balance = true
font-family = "Cascadia Mono NF Regular"
font-family-bold = "Cascadia Mono NF Bold"
font-family-italic = "Cascadia Mono NF Italic"
font-family-bold-italic = "Cascadia Mono NF Bold Italic"
font-thicken = true

# 2 Control

# hover mouse over a pane to focus it
focus-follows-mouse = true
# 󰘳+` to summon term
keybind = global:cmd+`=toggle_visibility
# opens URLs
link-url = true
# select text to both selection and system clipboard
copy-on-select = clipboard
# treat left option as alt
macos-option-as-alt = left

# 3 Tmux Integration

# Go to Nth window in tmux via 󰘴+a+[0-9]
keybind = super+one=text:\x01\x31
keybind = super+two=text:\x01\x32
keybind = super+three=text:\x01\x33
keybind = super+four=text:\x01\x34
keybind = super+five=text:\x01\x35
keybind = super+six=text:\x01\x36
keybind = super+seven=text:\x01\x37
keybind = super+eight=text:\x01\x38
keybind = super+nine=text:\x01\x39

# Window Control
# 󰘳+t - new window
keybind = super+t=text:\x01\x63
# 󰘳+r - rename window
keybind = super+r=text:\x01\x2c
# 󰘳+w - close window
keybind = super+w=text:\x01\x26
