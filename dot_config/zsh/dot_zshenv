# Zsh environment

path=(
  '/opt/nvim/bin'
  '$HOME/.local/bin'
  '/usr/local/go/bin'
  '$HOME/Library/Python/3.9/bin'
  '$HOME/.orbstack/bin'
  '$XDG_DATA_HOME/pnpm/bin'
  $path
)

export PATH

# [blinq] Set DD_SITE for datadog
export DD_SITE="us5.datadoghq.com"

# Set XDG dir for PNPM data
export PNPM_HOME="$XDG_DATA_HOME/pnpm"

# AWS config
export AWS_CONFIG_FILE="$XDG_CONFIG_HOME/aws/config"
export AWS_SHARED_CREDENTIALS_FILE="$XDG_CONFIG_HOME/aws/credentials"

# kubernetes config
# this setting can be path separated with ':'
export KUBECONFIG="$XDG_CONFIG_HOME/kube/config"

# Move .npmrc into XDG config home
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npmrc"

# OCI config file location
export OCI_CLI_CONFIG_FILE="$XDG_CONFIG_HOME/oci/config"
export OCI_CLI_RC_FILE="$XDG_CONFIG_HOME/oci/oci_cli_rc"
